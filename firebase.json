{
  "hosting": {
    "site": "privadin-d7ebe",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "dev-privadin",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ]
}
