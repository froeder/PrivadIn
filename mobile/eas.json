{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_FIRESTORE_DATABASE_ID": "dev-privadin"
      }
    },
    "preview-aab": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_FIRESTORE_DATABASE_ID": "dev-privadin"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
